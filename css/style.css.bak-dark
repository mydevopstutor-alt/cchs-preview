:root{--navy:#0b2a3b;--navy2:#082231;--card:#123a50;--text:#ffffff;--muted:#b9d6dd;--a1:#3ddc5f;--a2:#6bd89a;--a3:#94d2bd;--g:linear-gradient(120deg,var(--a1),var(--a2) 50%,var(--a3));--r:18px}
*{box-sizing:border-box;margin:0;padding:0}html{scroll-behavior:smooth}
body{font-family:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;background:var(--navy);color:var(--text);line-height:1.6}
a{color:var(--a3)}img{max-width:100%}
.skip{position:absolute;left:-999px}.skip:focus{left:1rem;top:1rem;background:#fff;color:#000;padding:.5rem;z-index:99}
.wrap{width:min(1180px,92%);margin:auto}
header{position:sticky;top:0;z-index:50;background:rgba(8,34,49,.85);backdrop-filter:blur(12px);border-bottom:1px solid #ffffff14}
.nav{display:flex;align-items:center;justify-content:space-between;padding:.9rem 0}
.logo{font-weight:900;font-size:1.4rem;letter-spacing:-.02em;color:#fff;text-decoration:none}.logo span{background:var(--g);-webkit-background-clip:text;background-clip:text;color:transparent}
nav ul{display:flex;gap:1.4rem;list-style:none;align-items:center}nav a{color:var(--muted);text-decoration:none;font-weight:600}nav a:hover,nav a[aria-current]{color:#fff}
.menu{display:none;background:none;border:1px solid #fff3;color:#fff;border-radius:8px;padding:.4rem .7rem;font-size:1.1rem}
.btn{display:inline-block;padding:.8rem 1.4rem;border-radius:999px;font-weight:700;text-decoration:none;border:0;cursor:pointer;font-size:1rem;transition:transform .2s,box-shadow .2s}
.btn-g{background:var(--g);color:#06202d;box-shadow:0 8px 30px #3ddc5f44}.btn-g:hover{transform:translateY(-2px);box-shadow:0 12px 40px #3ddc5f66}
.btn-o{border:2px solid #ffffff40;color:#fff}.btn-o:hover{border-color:var(--a3)}
.hero{position:relative;overflow:hidden;padding:7rem 0 6rem}
.blob{position:absolute;border-radius:50%;filter:blur(80px);opacity:.35;animation:float 14s ease-in-out infinite alternate}
.b1{width:480px;height:480px;background:var(--a2);top:-120px;right:-80px}.b2{width:380px;height:380px;background:var(--a1);bottom:-160px;left:-100px;animation-delay:-5s}.b3{width:260px;height:260px;background:var(--a3);top:40%;left:55%;animation-delay:-9s}
@keyframes float{to{transform:translate(40px,30px) scale(1.12)}}
.hero .wrap{position:relative}
.eyebrow{display:inline-block;padding:.35rem .9rem;border:1px solid #ffffff2a;border-radius:999px;color:var(--muted);font-size:.85rem;font-weight:600;margin-bottom:1.2rem}
h1{font-size:clamp(2.4rem,6vw,4.6rem);line-height:1.05;letter-spacing:-.03em;font-weight:900;max-width:16ch}
h2{font-size:clamp(1.8rem,3.6vw,2.7rem);letter-spacing:-.02em;line-height:1.15;margin-bottom:1rem}
h3{font-size:1.2rem;margin-bottom:.5rem}
.grad{background:var(--g);-webkit-background-clip:text;background-clip:text;color:transparent}
.lead{font-size:1.2rem;color:var(--muted);max-width:60ch;margin:1.3rem 0 2rem}
.ctas{display:flex;gap:1rem;flex-wrap:wrap}
section{padding:5rem 0}.alt{background:var(--navy2)}
.grid{display:grid;gap:1.4rem;grid-template-columns:repeat(auto-fit,minmax(260px,1fr))}
.card{background:var(--card);border:1px solid #ffffff12;border-radius:var(--r);padding:1.7rem;position:relative;transition:transform .25s,border-color .25s}
.card:hover{transform:translateY(-4px);border-color:#3ddc5f88}
.card .ic{width:48px;height:48px;border-radius:14px;background:var(--g);display:grid;place-items:center;font-size:1.4rem;margin-bottom:1rem}
.card p{color:var(--muted)}.card ul{color:var(--muted);padding-left:1.1rem;margin:.6rem 0}
.tag{display:inline-block;font-size:.75rem;font-weight:700;padding:.2rem .6rem;border-radius:999px;background:#3ddc5f26;color:#bff2cc;margin:.15rem .2rem 0 0}
.band{background:linear-gradient(120deg,#1f8f43,#2a8a6e 55%,#3d7f86);border-radius:24px;padding:3rem;color:#fff}.band p{opacity:.92;max-width:65ch;margin:.6rem 0 1.5rem}.band a.btn{background:#082231;color:#fff}
.ph{border:2px dashed #ffffff33;border-radius:var(--r);padding:1.4rem;color:var(--muted);font-style:italic;text-align:center}
.two{display:grid;grid-template-columns:1fr 1fr;gap:2.5rem;align-items:start}
form{display:grid;gap:1rem}label{font-weight:600;font-size:.92rem;display:grid;gap:.35rem}
input,select,textarea{font:inherit;padding:.75rem .9rem;border-radius:12px;border:1px solid #ffffff26;background:#071d2a;color:#fff}
input:focus,select:focus,textarea:focus,a:focus-visible,button:focus-visible{outline:3px solid var(--a3);outline-offset:2px}
.note{font-size:.85rem;color:var(--muted)}.ok{display:none;padding:1rem;border-radius:12px;background:#3ddc5f22;border:1px solid var(--a3)}
.steps{counter-reset:s}.steps .card::before{counter-increment:s;content:counter(s,decimal-leading-zero);font-size:2.2rem;font-weight:900;background:var(--g);-webkit-background-clip:text;color:transparent;display:block}
footer{border-top:1px solid #ffffff14;padding:3rem 0;color:var(--muted);font-size:.92rem}footer .grid a{display:block;color:var(--muted);text-decoration:none}
.wa{position:fixed;right:22px;bottom:22px;width:60px;height:60px;border-radius:50%;background:#25d366;display:grid;place-items:center;box-shadow:0 8px 24px #0008;z-index:60;color:#fff;font-size:1.7rem;text-decoration:none}
.reveal{opacity:0;transform:translateY(24px);transition:opacity .7s,transform .7s}.reveal.in{opacity:1;transform:none}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}.reveal{opacity:1;transform:none}}
@media(max-width:860px){.menu{display:block}nav ul{display:none;position:absolute;top:100%;left:0;right:0;flex-direction:column;background:var(--navy);padding:1rem}nav ul.open{display:flex}.two{grid-template-columns:1fr}.band{padding:2rem}}
/* hero 3D course stream */
.tagline{margin-top:1rem;font-size:clamp(1.1rem,2vw,1.45rem);font-weight:700;color:#d6f3ea;letter-spacing:.01em;max-width:30ch}
.hero-grid{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,.95fr);gap:2rem;align-items:center}
.hero-copy{position:relative;z-index:2}
.orbit{position:relative;height:520px;perspective:900px;perspective-origin:30% 20%;-webkit-mask-image:radial-gradient(ellipse at 55% 50%,#000 55%,transparent 80%);mask-image:radial-gradient(ellipse at 55% 50%,#000 55%,transparent 80%)}
.plane{list-style:none;position:absolute;inset:0;transform-style:preserve-3d;transform:rotateX(14deg) rotateY(-24deg)}
.plane li{position:absolute;left:12%;top:50%;width:290px;padding:.75rem 1.1rem;border-radius:16px;background:linear-gradient(135deg,rgba(18,58,80,.92),rgba(11,42,59,.86));border:1px solid #94d2bd55;box-shadow:0 0 28px #3ddc5f33,inset 0 0 0 1px #94d2bd1a;backdrop-filter:blur(6px);opacity:0;will-change:transform,opacity,filter;
 animation:drift 26s linear infinite;animation-delay:calc(var(--i) * -2.1667s)}
.plane li strong{display:block;font-size:1rem;color:#fff}
.plane li span{display:block;font-size:.84rem;color:#c8f0e2;line-height:1.35}
.plane li:nth-child(odd){left:0}.plane li:nth-child(even){left:34%}
@keyframes drift{
0%{transform:translate3d(80px,640px,-650px);opacity:0;filter:blur(3px)}
32%{opacity:0;filter:blur(2px)}
42%{opacity:.9;filter:blur(.4px)}
48%,58%{opacity:1;filter:blur(0)}
66%{opacity:.85;filter:blur(.6px)}
74%{opacity:0;filter:blur(3px)}
100%{transform:translate3d(-60px,-720px,200px);opacity:0;filter:blur(4px)}}
@media(max-width:980px){.hero-grid{grid-template-columns:1fr}.orbit{display:none}}
@media(prefers-reduced-motion:reduce){.orbit{height:auto;perspective:none;-webkit-mask-image:none;mask-image:none}.plane{position:static;transform:none;display:grid;gap:.6rem}.plane li{position:static;opacity:1;filter:none;width:auto;transform:none}.plane li:nth-child(n+7){display:none}}

.logo svg{display:block;height:40px;width:auto}.card .ic{color:#06202d}

.tagline{overflow:hidden}.tagline span{display:inline-block}
.tl1{animation:tlR .9s ease-out both}
.tl2{animation:tlF .8s ease-out .9s both}
.tl3{animation:tlU 1s ease-out 1.7s both}
@keyframes tlR{from{opacity:0;transform:translateX(60px)}to{opacity:1;transform:none}}
@keyframes tlF{from{opacity:0}to{opacity:1}}
@keyframes tlU{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
.shot .tagline span{animation:none!important;opacity:1;transform:none}
/* ---- CCHS additions ---- */
.draft{background:#ffd54a;color:#1a1300;text-align:center;font-size:.85rem;font-weight:700;padding:.35rem 1rem;position:relative;z-index:70}
.phx{background:#ffd54a2e;border:1px dashed #ffd54a;color:#ffe9a3;border-radius:6px;padding:0 .35rem;font-style:normal;font-weight:600;white-space:normal}
.phx::before{content:"⚑ ";}
.trust{background:var(--navy2);border-bottom:1px solid #ffffff12;padding:1rem 0;font-size:.92rem;color:var(--muted)}
.trust .wrap{display:flex;flex-wrap:wrap;gap:.6rem 1.6rem}.trust b{color:#fff}
.meta{color:var(--muted);font-size:.92rem;margin:.4rem 0}.fee{font-weight:700;color:#d6f3ea}
.filters{display:flex;flex-wrap:wrap;gap:.6rem;margin:1rem 0 1.6rem;align-items:center}
.chip{background:#123a50;border:1px solid #ffffff22;color:#fff;border-radius:999px;padding:.45rem 1rem;font-weight:600;cursor:pointer;font:inherit}
.chip[aria-pressed=true]{background:var(--g);color:#06202d;border-color:transparent}
.filters input{min-width:240px;flex:1}
.card a.more{font-weight:700;text-decoration:none}
table{width:100%;border-collapse:collapse;font-size:.92rem}th,td{padding:.6rem .7rem;border-bottom:1px solid #ffffff14;text-align:left}th{color:var(--a3);position:sticky;top:0;background:var(--navy2)}
.tbl{overflow-x:auto;border-radius:var(--r);border:1px solid #ffffff14}
td.n,th.n{text-align:right;white-space:nowrap}
details{background:var(--card);border:1px solid #ffffff12;border-radius:14px;padding:1rem 1.3rem;margin-bottom:.8rem}summary{cursor:pointer;font-weight:700}details p{color:var(--muted);margin-top:.6rem}
.quiz fieldset{border:0;display:grid;gap:.5rem;margin-bottom:1rem}.quiz legend{font-weight:700;margin-bottom:.4rem}
.quiz label{display:flex;gap:.6rem;align-items:center;font-weight:500;background:#071d2a;border:1px solid #ffffff1f;padding:.6rem .8rem;border-radius:12px;cursor:pointer}
.result{margin-top:1rem}.big{font-size:2rem;font-weight:900}
.map{width:100%;height:340px;border:0;border-radius:var(--r)}
.crumb{color:var(--muted);font-size:.9rem;margin-bottom:1rem}.crumb a{text-decoration:none}
.phero{padding:4.5rem 0 3rem}.phero h1{font-size:clamp(2rem,4.6vw,3.4rem);max-width:22ch}
.kv{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:1rem;margin:1.5rem 0}.kv div{background:var(--card);border-radius:14px;padding:1rem}.kv b{display:block;font-size:1.4rem}.kv span{color:var(--muted);font-size:.85rem}
.logo svg{height:44px}
nav ul{gap:1rem;font-size:.92rem}
@media(max-width:1240px){.menu{display:block}nav ul{display:none;position:absolute;top:100%;left:0;right:0;flex-direction:column;background:var(--navy);padding:1rem}nav ul.open{display:flex}}
nav a{white-space:nowrap}nav ul{gap:.9rem}.logo svg{height:38px}

.logo img{display:block;height:48px;width:auto;background:#fff;border-radius:10px;padding:4px 8px;box-sizing:content-box}.flogo{display:block;height:56px;width:auto;background:#fff;border-radius:12px;padding:6px 10px;margin-bottom:.8rem}@media(max-width:600px){.logo img{height:44px}}
